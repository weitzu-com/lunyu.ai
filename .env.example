NEXT_PUBLIC_SITE_URL=https://www.lunyu.ai
CHAT_ALLOWED_ORIGINS=https://www.lunyu.ai,https://lunyu.ai,http://localhost:3000,http://127.0.0.1:3000

# Supabase Marketplace injects these automatically. Pull into .env.local.
# Keep server credentials out of NEXT_PUBLIC_* variables and source control.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Only required when running database migrations locally.
POSTGRES_URL=
